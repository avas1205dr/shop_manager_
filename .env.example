# ── Секреты Telegram ─────────────────────────────────────────────────
# Токен главного (manager) бота — выдаётся @BotFather.
BOT_TOKEN=

# Единый Telegram Payments токен ПЛАТФОРМЫ (получается через @BotFather
# для МЕНЕДЖЕР-БОТА, /mybots → выбрать бота → Payments → выбрать провайдера,
# например PayMaster/ЮKassa). Через него идут ВСЕ платежи покупателей во
# всех магазинах. Деньги при оплате зачисляются на внутренний баланс
# продавца (в БД), а реальные выплаты делает владелец платформы (OWNER_IDS)
# после получения уведомления о выводе.
#
# ВАЖНО: provider-токен Telegram Payments привязан к КОНКРЕТНОМУ боту, поэтому
# invoice через него умеет отправлять только МЕНЕДЖЕР-БОТ. Магазин-боты
# отправляют покупателей по deeplink в менеджер-бота для оплаты.
#
# Если оставить пустым — онлайн-оплата отключена везде, остаётся только «при получении».
PAYMENTS_TOKEN=

# Username менеджер-бота без @ (например, my_shop_manager_bot). Используется
# магазин-ботами для построения deeplink t.me/<username>?start=pay_<order_id>
# при онлайн-оплате. Если оставить пустым, бот автоматически узнает username
# через Bot API при старте — переменная нужна только для нестандартных случаев.
MANAGER_BOT_USERNAME=

# ── Модерация и владельцы ────────────────────────────────────────────
# Telegram ID владельцев главного бота (через запятую). Имеют все права
# модераторов плюс право удалять магазины и закрывать споры.
OWNER_IDS=

# Telegram ID модераторов (через запятую). Видят жалобы, переводят магазины
# в статус `under_review` и обратно, могут участвовать в спорах. Не могут
# удалять магазины (право только OWNER_IDS).
MODERATOR_IDS=

# Сколько уникальных жалоб должно накопиться, прежде чем магазин
# автоматически перейдёт в статус `under_review` (новые покупки блокируются).
COMPLAINT_THRESHOLD=5

# ── База данных ──────────────────────────────────────────────────────
# Путь к SQLite-файлу относительно корня проекта.
DB_PATH=db/shop_manager.db

# ── Финансы ──────────────────────────────────────────────────────────
# Минимальная сумма вывода в рублях. Запросы на меньшую сумму бот не пропускает.
MIN_WITHDRAWAL=1000

# ── Логирование ──────────────────────────────────────────────────────
# Уровень логирования: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
