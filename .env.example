# ── Секреты Telegram ─────────────────────────────────────────────────
# Токен главного (manager) бота — выдаётся @BotFather.
BOT_TOKEN=

# (Опционально) тестовый/боевой Telegram Payments token, если используется
# в будущем для глобальных платежей менеджер-бота. Магазины используют
# свои PayMaster токены, которые сохраняются в БД.
PAYMENTS_TOKEN=

# ── Модерация и владельцы ────────────────────────────────────────────
# Telegram ID владельцев главного бота (через запятую). Имеют все права
# модераторов плюс право удалять магазины и закрывать споры.
OWNER_IDS=

# Telegram ID модераторов (через запятую). Видят жалобы, переводят магазины
# в статус `under_review` и обратно, могут участвовать в спорах. Не могут
# удалять магазины (право только OWNER_IDS).
MODERATOR_IDS=

# Сколько уникальных жалоб должно накопиться, прежде чем магазин
# автоматически перейдёт в статус `under_review` (новые покупки блокируются).
COMPLAINT_THRESHOLD=5

# ── База данных ──────────────────────────────────────────────────────
# Путь к SQLite-файлу относительно корня проекта.
DB_PATH=db/shop_manager.db

# ── Логирование ──────────────────────────────────────────────────────
# Уровень логирования: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
